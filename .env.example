# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase public browser configuration. Never put a service_role key here.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Server-only Cloudflare Worker variables. Set these with `wrangler secret put`.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# APP_URL=https://your-domain.com
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_AGENCY_MONTHLY=price_...
# STRIPE_PRICE_AGENCY_ANNUAL=price_...
# WEBHOOK_ENCRYPTION_KEY=generate-a-long-random-value
# LinkedIn direct publishing (configure the LinkedIn app redirect URI as APP_URL/api/social/linkedin/callback)
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# SOCIAL_OAUTH_ENCRYPTION_KEY=generate-a-separate-long-random-value
# LINKEDIN_VERSION=202603
# TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=your-meta-app-secret
# META_VERIFY_TOKEN=generate-a-long-random-webhook-verification-token
# META_GRAPH_API_VERSION=v23.0
# X direct publishing (configure the X OAuth 2.0 redirect URI as APP_URL/api/social/x/callback)
# X_CLIENT_ID=your-x-oauth-client-id
# X_CLIENT_SECRET=your-x-oauth-client-secret
# YouTube direct publishing (configure the Google OAuth redirect URI as APP_URL/api/social/youtube/callback)
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Threads direct publishing (configure the Threads OAuth redirect URI as APP_URL/api/social/threads/callback)
# THREADS_CLIENT_ID=your-threads-app-client-id
# THREADS_CLIENT_SECRET=your-threads-app-client-secret
# CLOUDFLARE_API_TOKEN=custom-hostnames-api-token (Worker secret only)
# CLOUDFLARE_ZONE_ID=zone-id-for-custom-hostnames (Worker secret only)
