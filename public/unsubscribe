<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Unsubscribe from LynkFlow updates</title>
    <style>
      :root { color-scheme: dark; font-family: system-ui, sans-serif; background: #0a0a0a; color: #f5f5f5; }
      body { display: grid; min-height: 100vh; place-items: center; margin: 0; padding: 24px; }
      main { width: min(100%, 480px); padding: 32px; border: 1px solid #2b2b2b; border-radius: 24px; background: #151515; }
      h1 { margin: 0 0 12px; font-size: 28px; }
      p { color: #b5b5b5; line-height: 1.6; }
      label { display: block; margin: 24px 0 8px; font-size: 13px; font-weight: 700; }
      input, button { box-sizing: border-box; width: 100%; min-height: 48px; border-radius: 12px; font: inherit; }
      input { padding: 0 14px; border: 1px solid #444; background: #0d0d0d; color: #fff; }
      button { margin-top: 12px; border: 0; background: #5b4bff; color: #fff; font-weight: 700; cursor: pointer; }
      a { color: #a5b4fc; }
      #status { min-height: 24px; margin-top: 16px; font-size: 13px; }
    </style>
  </head>
  <body>
    <main>
      <a href="/">← LynkFlow</a>
      <h1>Unsubscribe from product updates</h1>
      <p>Enter your email address and we will stop sending marketing updates. This does not affect essential account or billing messages.</p>
      <form id="unsubscribe-form">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" autocomplete="email" required>
        <button type="submit">Unsubscribe</button>
      </form>
      <p id="status" role="status"></p>
      <p><a href="/privacy">Read our privacy policy</a></p>
    </main>
    <script>
      document.getElementById('unsubscribe-form').addEventListener('submit', async function (event) {
        event.preventDefault();
        var status = document.getElementById('status');
        status.textContent = 'Processing…';
        try {
          var response = await fetch('/api/public/newsletter/unsubscribe', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email: document.getElementById('email').value }) });
          var body = await response.json();
          if (!response.ok) throw new Error(body.error && body.error.message ? body.error.message : 'Please try again.');
          status.textContent = 'You have been unsubscribed from LynkFlow marketing updates.';
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Please try again.';
        }
      });
    </script>
  </body>
</html>
