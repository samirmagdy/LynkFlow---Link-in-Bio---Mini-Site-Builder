{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lynkflow",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
